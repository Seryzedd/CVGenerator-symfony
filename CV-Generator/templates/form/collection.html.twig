<div class="row">
    {% for entity in form %}
        <div class="col-12 px-2 py-2 collection-elements">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="col-12 text-primary d-block">{% trans %}Blocks{% endtrans %} {{ entity.title.vars.data }}</h3>
                </div>
                
                <button type="button" value="{{ entity.vars.data.id }}" class="btn btn-danger remove-btn btn-sm" ><i class="fa-solid fa-trash-can"></i></button>
            </div>

            <div class="d-flex align-items-end justify-content-end mb-2">
                <div class="icons-autocomplete w-75">
                    {{ form_label(entity.prefixClass) }}
                    {{ form_widget(entity.prefixClass) }}
                    <ul class="dropdown-menu"></ul>
                </div>

                <h3 class="prefix-icon-preview mb-0 text-center text-muted w-25">
                    {% if entity.prefixClass.vars.data %}
                        <i class="{{ entity.prefixClass.vars.data }}"></i>
                    {% endif %}
                </h3>
            </div>

            {{ form_row(entity.title) }}
            {{ form_row(entity.placement) }}
            {{ form_row(entity.withDates) }}

            <!-- Add blocklines -->
            <button class="btn btn-light d-flex w-100 justify-content-between align-items-center text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapselines-{{ entity.vars.data.id }}" aria-expanded="false" aria-controls="collapselines-{{ entity.vars.data.id }}">
                {% trans %}Lines{% endtrans %}
                <i class="fa-solid fa-angle-down"></i>
            </button>
            <div class="collapse" id="collapselines-{{ entity.vars.data.id }}">
                <div class="card card-body">
                    <div classe="col-12 ps-4 border-top">
                        <div class="row">
                            {% for subForm in entity.blockLines %}
                                <div class="col-6">
                                    <h3 class="text-primary">{% trans %}Line{% endtrans %} {{ subForm.title.vars.data }}</h3>
                                </div>
                                <div class="col-6 text-end">
                                    <button value="{{ subForm.vars.data.id }}" name="remove_line" class="btn btn-danger remove-btn btn-sm"><i class="fa-solid fa-trash-can"></i></button>
                                </div>
                                <div class="col-6">
                                    {{ form_row(subForm.startAt) }}
                                </div>
                                <div class="col-6">
                                    {{ form_row(subForm.endAt) }}
                                </div>
        
                                <div class="col-12 px-2 py-2">
                                    {{ form_widget(subForm.block) }}
                                </div>

                                <button class="btn btn-light d-flex w-100 justify-content-between align-items-center text-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#line-details-{{ subForm.vars.data.id }}" aria-expanded="false" aria-controls="line-details-{{ subForm.vars.data.id }}">
                                    {% trans %}Details{% endtrans %}
                                    <i class="fa-solid fa-angle-down"></i>
                                </button>

                                <div class="collapse ps-4" id="line-details-{{ subForm.vars.data.id }}">
                                    <div class="row mb-2 align-items-baseline">
                                        {% set formRender = form_widget(subForm.lineDetails.vars.prototype) %}

                                        {% for detail in subForm.lineDetails %}
                                            <div class="col-4">
                                                {{ form_row(detail.beforeCharacter) }}
                                            </div>

                                            <div class="col-8">
                                                {{ form_row(detail.title) }}
                                            </div>

                                            <div class="col-12">
                                                {{ form_row(detail.line) }}
                                            </div>
                                        {% endfor %}
                                        
                                        <ul
                                            class="details-{{ subForm.vars.data.id }} mb-0"
                                            data-index="{{ subForm.lineDetails|length > 0 ? subForm.lineDetails|last.vars.name + 1 : 0 }}"
                                            data-prototype="{{ formRender|e('html_attr') }}"
                                            >
                                        </ul>

                                        <div class="col-12 text-end">
                                            <button type="button" class="btn btn-secondary add_collection btn-sm" data-collection-holder-class="details-{{ subForm.vars.data.id }}">
                                                <span class="fa fa-plus"></span>
                                                {% trans with {'%buttonName%': 'Add new Line detail'} %}%buttonName%{% endtrans %}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                            
                            {% if form.vars.allow_add %}
                                <ul class="lines-{{ entity.vars.data.id }} mb-0" data-index="{{ entity.blockLines|length > 0 ? entity.blockLines|last.vars.name + 1 : 0 }}" data-prototype="{{ form_widget(entity.blockLines.vars.prototype)|e('html_attr') }}"></ul>
                                
                                <div class="col-12 text-start mb-2">
                                    <button type="button" class="btn btn-secondary add_collection btn-sm" data-collection-holder-class="lines-{{ entity.vars.data.id }}">
                                        <span class="fa fa-plus"></span>
                                        {% trans with {'%buttonName%': "Add new line"} %}%buttonName%{% endtrans %}
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
    
    <div class="d-none">
        {{ form_rest(form) }}
    </div>
    
    {% if form.vars.allow_add %}
        <ul class="{{ classname }} mb-0" data-index="{{ form|length > 0 ? form|last.vars.name + 1 : 0 }}" data-prototype="{{ form_widget(form.vars.prototype)|e('html_attr') }}"></ul>
        
        <div class="col-12 text-end pb-2">
            <button type="button" class="btn btn-secondary add_collection btn-sm" data-collection-holder-class="{{ classname }}">
                <span class="fa fa-plus"></span>
                {% trans with {'%buttonName%': buttonName} %}%buttonName%{% endtrans %}
            </button>
        </div>
    {% endif %}
</div>