<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" type="image/x-icon" href="{{ asset('img/favicon.svg') }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/fontawesome6.7.2/css/all.min.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        {% endblock %}

        
    </head>
    <body>
        {% block header %}
            {% include "partials/header.html.twig" %}
        {% endblock %}

        <main>
            {% block alert_messages %}
                {% for type, messages in app.session.flashbag.all() %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} container">
                            <p class="mb-0 d-flex justify-content-between">
                                <span>
                                    {% if type == 'success' %}
                                        <i class="fas fa-thumbs-up fa-lg fa-lg mr-2"></i>
                                    {% elseif type == 'danger' %}
                                        <i class="fas fa-skull-crossbones fa-lg mr-2"></i>
                                    {% elseif type =="warning" %}
                                        <i class="fas fa-exclamation-triangle fa-lg mr-2"></i>
                                    {% elseif  type =="info" %}
                                        <i class="fas fa-info-circle fa-lg mr-2"></i>
                                    {% endif %}
                                    {{ message|trans|raw }}
                                </span>

                                <button type="button" class="btn-close" aria-label="Close">
                                    <span aria-hidden="true"></span>
                                </button>
                            </p>

                            
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}
            <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
            <script type="module" src="{{ asset('app.js') }}"></script>
        {% endblock %}
    </body>
</html>
