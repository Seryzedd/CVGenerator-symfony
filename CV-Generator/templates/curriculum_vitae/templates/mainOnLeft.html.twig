<body>
    <style>
        body {
            width: 21cm;
            height: 29.7cm;
            display: flex;
            margin: 0 !important;
            padding: 0 !important;
        }

        @page {
            size: 8.5in 11in !important;
            bleed: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        aside {
            width: 25%;
            background-color: {{ cv.sideColor }};
        }

        main {
            width: 75%;
            {% if cv.mainColor %}
                background-color: {{ cv.mainColor }};
            {% endif %}
            {% if cv.textMainColor %}
                color: {{ cv.textMainColor }};
            {% endif %}
            padding: 0;
        }

        .head {
            {% if cv.headBGColor is not null %}
                background-color: {{ cv.headBGColor }};
            {% endif %}
            {% if cv.headTextColor is not null %}
                
            {% endif %}
        }

        h1, h2, h3, h4, h5, p {
            margin-bottom: 0;
            margin-top: 0;
            padding: 0 20px;
        }

        aside > img {
            max-width: 100%;
            margin: auto;
        }

        .row {
            display: flex;
        }

        .padding-2 {
            padding: 2rem;
        }

        .padding-x-2 {
            padding-left: 2rem;
            padding-right: 2rem;
        }

        .padding-y-2 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .padding-1 {
            padding: 1rem;
        }

        .padding-x-1 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .padding-y-1 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
    </style>
    <aside>
        {% if cv.profileImg %}
            <img src='{{ cv.profileImg }}' alt=''>
        {% endif %}
        <h2 style='color: {{ cv.titleSideColor ?: 'unset' }};'>Coordonnées</h2>
        <h3><strong>{{ cv.user.email }}</strong></h3>
        {% if cv.user.coordinates %}
            <p><strong>{% trans %}Phone{% endtrans %}</strong></p>
            <p>{{ cv.user.coordinates.phone }}</p>
            <p><strong>{% trans %}Adress{% endtrans %}</strong></p>
            <p>{{ cv.user.coordinates.street }}</p>
            <p>{{ cv.user.coordinates.zipcode }} {{ cv.user.coordinates.city }}</p>
            <p>{{ cv.user.coordinates.clearCountry }}</p>
        {% endif %}
        
        {% for bl in cv.blocks %}
            {% if bl.placement == 'side' %}
                <h2 style='color: {{ cv.titleSideColor ?: 'unset' }};'>{{ bl.title }}</h2>
            {% endif %}
        {% endfor %}
    </aside>
    <main>
        <div class='head padding-1'>
            <h1>{{ cv.user.gender }} {{ cv.user.firstname }} {{ cv.user.lastname }}</h1>
            <h2>{{ cv.name }}</h2>
            <p>{{ cv.description }}</p>
        </div>
        
        <div class='padding-1'>
            {% for bl in cv.blocks %}
                {% if bl.placement == 'main' %}
                    <h2 style='color: {{ cv.titleMainColor ?: 'unset' }};'>{{ bl.title }}</h2>
                    
                    {% for line in bl.blockLines %}
                        <div class='row'>
                            {% if bl.withDates %}
                                <div>
                                    {% if line.startAt %}
                                        <p><strong>{% trans with {'%startDate%': line.startAt|date("d/m/Y")} %}From %startDate%{% endtrans %}</strong></p>
                                    {% endif %}

                                    {% if line.endAt %}
                                        <p><strong>{% trans with {'%endDate%': line.endAt|date("d/m/Y")} %}To %endDate%{% endtrans %}</strong></p>
                                    {% endif %}
                                </div>
                            {% endif %}
                            
                            <div>
                                <h3>{{ line.title }}</h3>
                                {% if line.companyName %}
                                    <p>{% trans with {'%company%': line.companyName} %}For %company%{% endtrans %}</p>
                                {% endif %}

                                <div class='col-12'>
                                    {% for detail in line.lineDetails %}
                                        <p>{% if detail.beforeCharacter %}{{ detail.beforeCharacter }} {% endif %}{{ detail.title }}</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </div>
    </main>
</body>