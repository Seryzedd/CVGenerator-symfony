<body>
    <style>
        body {
            width: 21cm;
            height: 29.7cm;
            display: flex;
        }

        aside {
            width: 25%;
            background-color: {{ cv.sideColor }};
            color: {{ cv.textSideColor }};
            padding: 20px;
        }

        main {
            width: 75%;
            background-color: {{ cv.mainColor }};
            color: {{ cv.textMainColor }};
            padding: 20px;
        }

        h1, h2, h3, h4, h5, p {
            margin-bottom: 5px;
            margin-top: 0;
        }
    </style>
    <aside>
        <h2>Coordonnées</h2>
        <h3><strong>{{ cv.user.email }}</strong></h3>
        {% if cv.user.coordinates %}
            <p><strong>{% trans %}Adress{% endtrans %}</strong></p>
            <p>{{ cv.user.coordinates.phone }}</p>
            <p>{{ cv.user.coordinates.street }}</p>
            <p>{{ cv.user.coordinates.zipcode }} {{ cv.user.coordinates.city }}</p>
            <p>{{ cv.user.coordinates.clearCountry }}</p>
        {% endif %}
        
    </aside>
    <main>
        <h1>{{ cv.user.gender }} {{ cv.user.firstname }} {{ cv.user.lastname }}</h1>
        <h2>{{ cv.name }}</h2>
    </main>
</body>