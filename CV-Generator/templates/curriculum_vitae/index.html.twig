{% extends 'base.html.twig' %}

{% block title %}{% trans %}My Curriculum Vitae list{% endtrans %}{% endblock %}

{% block body %}
    <div class="container bg-light p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="text-primary">{% trans %}My Curriculum vitae list{% endtrans %}</h1>

            <a class="btn btn-outline-primary" href="{{ path('app_curriculum_vitae_new') }}">
                <i class="fa-solid fa-plus"></i> {% trans %}Add new{% endtrans %}
            </a>
        </div>
        
        {% if CVs|length == 0 %}
            <div class="text-muted text-center p-4">
                <h2 class="">{% trans %}You don't have Curriculum vitae actually{% endtrans %}.</h2>
            </div>
        {% else %}
            {% for cv in CVs %}
                <div class="row align-items-center mt-2 border bg-white py-2">
                    <div class="col-md-1">
                        {% if cv.profileImg %}
                            <img src="{{ cv.profileImg }}" style="max-width: 100%;">
                        {% endif %}
                    </div>

                    <div class="col-md-4">
                        <h4 class="text-primary mb-0">{{ cv.name }}</h4>
                    </div>

                    <div class="col-md-3">
                        <p class="mb-0"><span class="text-muted">{% trans %}Template{% endtrans %} :</span> {{ cv.template|replace({'.html.twig': ''}) }}</p>
                    </div>

                    <div class="col-md-4 text-end">
                        <a href="{{ path('app_pdf', {'cv': cv.id}) }}" class="btn btn-light"><i class="fa-regular fa-floppy-disk"></i></a>
                        <a href="{{ path('app_curriculum_vitae_update', {'id': cv.id}) }}" class="btn btn-light"><i class="fa-solid fa-pen"></i></a>
                        <a href="{{ path('app_curriculum_vitae_remove', {'id': cv.id}) }}" class="btn btn-outline-danger"><i class="fa-regular fa-trash-can"></i></a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
