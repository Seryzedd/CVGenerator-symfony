<div class="row">
    <div class="col-md-6">
        {{ form_start(form) }}
            {{ form_row(form.name) }}

            {{ form_row(form.description, {attr: {rows: '5'}}) }}

            <div class="row align-items-center">
                <div class="col-4 offset-4 col-md-2 offset-md-0">
                    <div id="img_preview" class="p-2 text-center text-muted">
                        {% if form.vars.data.profileImg %}
                            <img src="{{ form.vars.data.profileImg }}" alt="">
                        {% else %}
                            <i class="fa-solid fa-camera fa-lg"></i>
                        {% endif %}
                    </div>
                </div>

                <div class="col-12 col-md-10">
                    {{ form_row(form.profileImg) }}
                </div>
            </div>
            
            {{ form_row(form.template) }}

            <button class="btn btn-light text-primary align-items-center w-100 mb-2 d-flex justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                {% trans %}Aesthetics{% endtrans %}
                <i class="fa-solid fa-angle-down"></i>
            </button>

            <div class="collapse" id="collapseExample">
                <div class="border-top border-primary bg-white pt-3 px-2">
                    
                    <div class="row">
                        <!-- Header block part -->
                        <h4 class="text-primary col-12">{% trans %}Head part{% endtrans %}</h4>
                        <div class="col-12">
                            {{ form_row(form.header.backgroundColor) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.header.merge.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.header.merge.type) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.header.padding.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.header.padding.type) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Main title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.header.mainTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.header.mainTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.header.mainTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Sub title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.header.subTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.header.subTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.header.subTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Paragraph{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.header.paragraph.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.header.paragraph.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.header.paragraph.color) }}
                        </div>

                        <!-- Side block part -->
                        <h4 class="text-primary col-12">{% trans %}Side part{% endtrans %}</h4>
                        <div class="col-12">
                            {{ form_row(form.asideBlock.backgroundColor) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.asideBlock.merge.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.asideBlock.merge.type) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.asideBlock.padding.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.asideBlock.padding.type) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Main title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.mainTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.mainTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.mainTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Sub title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.subTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.subTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.subTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Paragraph{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.paragraph.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.paragraph.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.asideBlock.paragraph.color) }}
                        </div>

                        <!-- Side block part -->
                        <h4 class="text-primary col-12">{% trans %}Main part{% endtrans %}</h4>
                        <div class="col-12">
                            {{ form_row(form.MainBlock.backgroundColor) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.MainBlock.merge.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.MainBlock.merge.type) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.MainBlock.padding.number) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.MainBlock.padding.type) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Main title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.mainTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.mainTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.mainTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Sub title{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.subTitle.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.subTitle.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.subTitle.color) }}
                        </div>

                        <h5 class="text-secondary col-12">{% trans %}Paragraph{% endtrans %}</h5>
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.paragraph.merge.number) }}
                        </div>
        
                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.paragraph.merge.type) }}
                        </div>

                        <div class="col-md-4">
                            {{ form_row(form.MainBlock.paragraph.color) }}
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-light text-primary align-items-center w-100 mb-2 d-flex justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapsingBlocks" aria-expanded="false" aria-controls="collapsingBlocks">
                {% trans %}Block{% endtrans %}
                <i class="fa-solid fa-angle-down"></i>
            </button>

            <div class="collapse" id="collapsingBlocks">
                <div class="border bg-white mb-2 py-2 px-3">
                    {% include "form/collection.html.twig" with {'form': form.blocks, 'buttonName': 'Add New block', 'classname': 'blocks', 'collectionChild': 'blockLines'} %}
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('app_curriculum_vitae') }}" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left me-2"></i>{% trans %}Back to list{% endtrans %}</a>
                
                <div>
                    <a href="" class="btn btn-outline-dark">{% trans %}Cancel{% endtrans %}</a>
                    <button type="submit" class="btn btn-primary ms-2">{% trans %}Save{% endtrans %}</button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="col-md-6">
        {% set templateName = form.template.vars.data %}
        {% if templateName is null %}
            {% set templateName = form.template.vars.choices|first.value %}
        {% endif %}
        
        <iframe style="width: 100%; max-width: 21cm; height: 29.7cm;" srcdoc="{% include 'curriculum_vitae/templates/' ~ templateName with {'cv': form.vars.data} %}"></iframe>
    </div>
</div>