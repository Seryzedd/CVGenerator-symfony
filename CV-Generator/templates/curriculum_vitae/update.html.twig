{% extends 'base.html.twig' %}

{% block title %}{% trans with {'%name%': form.name.vars.data} %}Update Curriculum Vitae %name%{% endtrans %}{% endblock %}

{% block body %}
    <div class="container bg-light p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="text-primary">{% trans  with {'%name%': form.name.vars.data} %}Update new Curriculum vitae %name%{% endtrans %}</h1>
            <a href="{{ path('app_curriculum_vitae_remove', {'id': form.vars.data.id}) }}" class="btn btn-outline-danger"><i class="fa-regular fa-trash-can"></i></a>
        </div>
        
        {% include 'curriculum_vitae/CVform.html.twig' with {'form': form} %}
    </div>
{% endblock %}