{% extends 'account/index.html.twig' %}

{% block title %}{% trans %}Updating my account{% endtrans %}{% endblock %}

{% block account_content %}
    <h1 class="text-secondary text-end">{% trans %}Updating my account{% endtrans %}</h1>
    <div class="p-4 border">
        {{ form_start(form) }}
            <h3 class="text-primary">{% trans %}Main informations{% endtrans %}</h2>
            {{ form_row(form.gender) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}

            <div class='row'>
                <div class="col-md-12">
                    <h3 class="text-primary">{% trans %}Coordinates{% endtrans %}</h2>
                </div>

                <div class="col-md-12">
                    {{ form_row(form.coordinates.phone) }}
                </div>

                <div class="col-md-12">
                    {{ form_row(form.coordinates.street) }}
                </div>

                <div class="col-md-6">
                    {{ form_row(form.coordinates.zipcode) }}
                </div>

                <div class="col-md-6">
                    {{ form_row(form.coordinates.city) }}
                </div>

                <div class="col-md-12">
                    {{ form_row(form.coordinates.country) }}
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('app_account') }}" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left me-2"></i>{% trans %}Return{% endtrans %}</a>
                <button type="submit" class="btn btn-primary">{% trans %}Update{% endtrans %}</button>
            </div>
        {{ form_end(form) }}
    </div>
    
{% endblock %}