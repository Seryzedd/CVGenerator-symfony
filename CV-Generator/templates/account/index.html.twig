{% extends 'base.html.twig' %}

{% block title %}{% trans %}My account{% endtrans %}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row align-items-center">
            {% if app.user %}
                <div class="col-md-4 bg-light p-3">
                    <h2 class='text-primary'>My account informations</h2>
                    <p class="text-muted h5">{{ app.user.gender }} {{ app.user.firstname }} {{ app.user.lastname }}</p>
                    <p class="text-muted">{{ app.user.email }}</p>
                    <p class="text-end mb-1">
                        <a href="{{ path('app_account_update') }}" class="btn btn-outline-dark"><i class="fa-solid fa-pen-to-square"></i></a>
                        <a href="{{ path('app_password_reset') }}" class="btn btn-outline-dark"><i class="fa-solid fa-key"></i></a>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                    </p>
                </div>

                <div class="col-md-8">
                    {% block account_content %}{% endblock %}
                </div>
            {% else %}
                <div class="col-12">
                    <h2>{% trans %}Login to have user informations{% endtrans %}</h2>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
