{% extends 'base.html.twig' %}

{% block title %}{% trans %}My account{% endtrans %}{% endblock %}

{% block body %}
    <div class="container pt-4">
        <div class="row align-items-center">
            {% if app.user %}
                <div class="col-md-4 bg-light p-3">
                    <h2 class='text-primary'>My account informations</h2>
                    <p class="text-muted h5">{{ app.user.gender }} {{ app.user.firstname }} {{ app.user.lastname }}</p>
                    <p class=""><strong class="me-2 w-50 d-inline-block">{% trans %}Email{% endtrans %} :</strong>{{ app.user.email }}</p>
                    {% if app.user.coordinates %}
                        <p class="mb-0"><strong class="me-2 w-50 d-inline-block">{% trans %}Phone number{% endtrans %} :</strong>{{ app.user.coordinates.phone }}</p>
                        <p class="mb-0">
                            <strong class="me-2 w-50 d-inline-block">{% trans %}Adress{% endtrans %} :</strong>{{ app.user.coordinates.street }}<br>
                            <strong class="me-2 w-50 d-inline-block"></strong>{{ app.user.coordinates.zipcode }} {{ app.user.coordinates.city }}<br>
                            <strong class="me-2 w-50 d-inline-block"></strong>{{ app.user.coordinates.clearCountry }}
                        </p>

                    {% endif %}
                    
                    <p class="text-end mb-1 pt-3">
                        {% if app.request.pathInfo != "/account" %}
                            <a href="{{ path('app_account') }}" class="btn btn-outline-dark"><i class="fa-regular fa-address-book"></i></a>
                        {% endif %}
                        <a href="{{ path('app_account_update') }}" class="btn btn-light"><i class="fa-solid fa-pen-to-square"></i></a>
                        <a href="{{ path('app_password_reset') }}" class="btn btn-light"><i class="fa-solid fa-key"></i></a>
                        <a href="{{ path('app_logout') }}" class="btn btn-danger"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                    </p>
                </div>

                <div class="col-md-8">
                    {{ block('account_content') }}
                </div>
            {% else %}
                <div class="col-12">
                    <h2>{% trans %}Login to have user informations{% endtrans %}</h2>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block account_content %}
    <div class="px-2">
        <h2 class="text-secondary">{% trans %}My curriculum vitae list{% endtrans %}</h2>

        {% for cv in app.user.curriculumVitaes %}
            <div class="row border align-items-center mb-2 py-2">
                <div class="col-6 offset-3 col-md-1 offset-md-0">
                    <img src="{{ cv.profileImg }}" class="img-fluid" alt="">
                </div>

                <div class="col-md-4">
                    <h3 class="text-primary text-center text-md-start mb-0">{{ cv.name }}</h3>
                </div>

                <div class="col-md-4">
                    <p class="text-dark text-center text-md-start mb-0">{{ cv.template|replace({'.html.twig': ''}) }}</p>
                </div>

                <div class="col-md-3">
                    <p class="text-center text-md-end mb-0">
                        <a href="{{ path('app_pdf', {'cv': cv.id}) }}" class="btn btn-light"><i class="fa-regular fa-floppy-disk"></i></a>
                        <a href="{{ path('app_curriculum_vitae_update', {'id': cv.id}) }}" class="btn btn-light"><i class="fa-solid fa-pen"></i></a>
                        <a href="{{ path('app_curriculum_vitae_remove', {'id': cv.id}) }}" class="btn btn-outline-danger"><i class="fa-regular fa-trash-can"></i></a>
                    </p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock account_content %}