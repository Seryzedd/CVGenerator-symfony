{% extends 'base.html.twig' %}

{% block title %}{% trans %}My account{% endtrans %}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            {% if user %}
                <div class="col-md-4 bg-light p-3">
                    <h2 class='text-primary'>My account informations</h2>
                    <p class="text-muted h5">{{ user.gender }} {{ user.firstname }} {{ user.lastname }}</p>
                    <p class="text-center mb-0"><a href="" class="btn btn-light">{% trans %}Change account informations{% endtrans %}</a></p>
                    <p class="text-center mb-0"><a href="" class="btn btn-light">{% trans %}Change my password{% endtrans %}</a></p>
                </div>

                <div class="col-md-8">
                </div>
            {% else %}
                <div class="col-12">
                    <h2>{% trans %}Login to have user informations{% endtrans %}</h2>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
