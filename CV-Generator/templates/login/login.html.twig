{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="container bg-light p-4 text-center">
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <h1 class="h3 mb-3 font-weight-normal text-primary">{% trans %}Login on platform{% endtrans %}</h1>

            {% if  app.user is null %}
                <p class=''>{% trans %}I want to create an account{% endtrans %}. <a href="{{ path('app_register') }}">{% trans %}Sign in{% endtrans %}</a></p>
            {% endif %}
            
            <label for="username">{% trans %}Email{% endtrans %}</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            <label for="password">{% trans %}Password{% endtrans %}</label>
            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token"value="{{ csrf_token('authenticate') }}">

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">{% trans %}Remember me{% endtrans %}</label>
            </div>

            <p class=''>{% trans %}Forgot my password{% endtrans %} ? <a href="{{ path('app_forgot_password_request') }}">{% trans %}Reset password{% endtrans %}</a></p>

            <button class="btn btn-lg btn-primary" type="submit">
                {% trans %}Login{% endtrans %}
            </button>
        </form>
    </div>
{% endblock %}
