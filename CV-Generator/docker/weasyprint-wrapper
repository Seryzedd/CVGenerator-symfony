#!/bin/bash
# Filtrer l'option --timeout des arguments
args=()
skip_next=0
for arg in "$@"; do
    if [ $skip_next -eq 1 ]; then
        skip_next=0
        continue
    fi
    if [ "$arg" == "--timeout" ]; then
        skip_next=1
        continue
    fi
    args+=("$arg")
done
# Appeler weasyprint avec les arguments filtrés
/opt/venv/bin/weasyprint "${args[@]}"